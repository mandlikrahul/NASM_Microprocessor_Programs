%macro write 2
   mov edx,%1
   mov esi,%2
   mov edi,1
   mov eax,1
   syscall
%endmacro

%macro read 2
mov edx,%1
mov esi,%2
mov edi,0
mov eax,0
syscall
%endmacro

%macro exit 0
mov eax,60
syscall
%endmacro

section .data
msg1 db 'block before execution :',0AH
len1 equ $-msg1
msg2 db 0X0a ,'source block :',0AH
len2 equ $-msg2
msg3 db ' destination block :',0AH
len3 equ $-msg3
srblk db 01h,02h,03h,04h,05h
msg4 db 0x0a ,'blocks after execution :'
len4 equ $-msg4
msg5 db 0x0a ,'enter the overlap size'
len5 equ $-msg5
cnt equ 5
desblk db 00h,00h,00h,00h,00h
spacechar db ''

section .bss
num2 resb 2
num1 resb 2
cnt1 resb 00h

section .text
global _start
	_start:

	write len1,msg1
	write len2,msg2
	call source
	write len3,msg3
	call destination
	write len5,msg5
	read 2,num1
	mov r8,num1
	mov bl,[r8]
	cmp bl,39h
	jbe t1
	sub bl,07h
	
t1 :	sub bl,30h
	mov [cnt1],bl
	write len4,msg4
	write len2,msg2
	call source
	write len3,msg3
	mov r8,srblk+4
	mov r9,r8
	add r9,[cnt1]
	mov cl,cnt
	
t2 :	mov al,[r8]
	mov [r9],al
	dec r9
	dec r8
	dec cl
	jnz t2
	call source1
	exit
display :
		mov ecx,02
		mov edi,num2
	l1:
		rol bl,4
		mov al,bl
		and al,0fh
		cmp al,09h
		jbe l2
		add al,07h
	l2:
		add al,30h
		mov [edi],al
		inc edi
		dec ecx
		jnz l1
		write 2,num2
		ret
		
source :
	mov r8,srblk
	xor rcx,rcx
	add rcx,cnt
	
	l7: 
	push rcx
	mov bl,[r8]
	call display
	write 1,spacechar
	inc r8
	pop rcx
	loop l7
	ret
	
source1 :
	mov r8,srblk
	xor rcx,rcx
	mov rcx,cnt
	add rcx,[cnt1]
l3 :	push rcx
	mov bl,[r8]
	call display
	inc r8
	pop rcx
	loop l3
	ret	

destination :
		mov r9,desblk
		xor rcx,rcx
		mov rcx,cnt
	l4 :
		push rcx
		mov bl,[r9]
		call display
		inc r9
		pop rcx
		loop l4
    ret
